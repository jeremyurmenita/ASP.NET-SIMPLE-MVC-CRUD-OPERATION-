@model IEnumerable<_231895urmenitaMVCCRUDOPERATION.Models._231895urmenitaSTUDENT>

@{
    ViewData["Title"] = "Students Per Course";
    var courses = ViewBag.Courses as IEnumerable<_231895urmenitaMVCCRUDOPERATION.Models._231895urmenitaCOURSE>;
}

<h2>Students Per Course</h2>

<form method="get" class="row g-3 mt-3">
    <div class="col-md-4">
        <select name="courseId" class="form-select">
            <option value="">-- All Courses --</option>
            @foreach (var c in courses)
            {
                <option value="@c.COURSEID">@c.DESCRIPTION</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Filter</button>
    </div>
</form>

<table class="table table-striped table-hover mt-3">
    <thead>
        <tr>
            <th>Name</th>
            <th>Course</th>
            <th>Gender</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.LNAME, @s.FNAME @s.MNAME</td>
                <td>@s.Course?.DESCRIPTION</td>
                <td>@s.GENDER</td>
            </tr>
        }
    </tbody>
</table>
