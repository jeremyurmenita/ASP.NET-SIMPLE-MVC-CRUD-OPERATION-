@model IEnumerable<_231895urmenitaMVCCRUDOPERATION.Models._231895urmenitaSTUDENT>

@{
    ViewData["Title"] = "All Students";
}

<h2>All Students</h2>

<table class="table table-striped table-hover mt-3">
    <thead>
        <tr>
            <th>Name</th>
            <th>Birthday</th>
            <th>Gender</th>
            <th>Course</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.LNAME, @s.FNAME @s.MNAME</td>
                <td>@s.BDAY.ToShortDateString()</td>
                <td>@s.GENDER</td>
                <td>@s.Course?.DESCRIPTION</td>
            </tr>
        }
    </tbody>
</table>
