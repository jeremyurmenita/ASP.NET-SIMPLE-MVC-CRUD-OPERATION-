@model _231895urmenitaMVCCRUDOPERATION.Models._231895urmenitaSTUDENT

<h2>Delete Student</h2>

<h4>Are you sure you want to delete this student?</h4>

<div class="card mt-3">
    <div class="card-body">

        <p><strong>Name:</strong> @Model.FNAME @Model.MNAME @Model.LNAME</p>
        <p><strong>Course:</strong> @Model.Course?.DESCRIPTION</p>
        <p><strong>Birthday:</strong> @Model.BDAY.ToShortDateString()</p>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="STUDENTID" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>

    </div>
</div>
