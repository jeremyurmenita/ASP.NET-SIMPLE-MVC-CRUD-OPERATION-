@{
    ViewData["Title"] = "Dashboard";

    var totalStudents = (int)ViewBag.TotalStudents;
    var totalCourses = (int)ViewBag.TotalCourses;
    var maleCount = (int)ViewBag.MaleCount;
    var femaleCount = (int)ViewBag.FemaleCount;
    var studentsPerCourse = ViewBag.StudentsPerCourse as IEnumerable<dynamic>;
}

<h2 class="mt-3">Dashboard</h2>

<div class="row mt-4">
    <div class="col-md-3 mb-3">
        <div class="card shadow-sm border-0">
            <div class="card-body text-center">
                <h6>Total Students</h6>
                <h3>@totalStudents</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card shadow-sm border-0">
            <div class="card-body text-center">
                <h6>Total Courses</h6>
                <h3>@totalCourses</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card shadow-sm border-0">
            <div class="card-body text-center">
                <h6>Male Students</h6>
                <h3>@maleCount</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card shadow-sm border-0">
            <div class="card-body text-center">
                <h6>Female Students</h6>
                <h3>@femaleCount</h3>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6 mb-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5>Students per Course (%)</h5>
                <canvas id="courseChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5>Male vs Female (%)</h5>
                <canvas id="genderChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Students per course
        var courseLabels = [
        @foreach (var item in studentsPerCourse)
        {
            @: "@item.Course",
            ;
        }
        ];

        var courseCounts = [
        @foreach (var item in studentsPerCourse)
        {
            @: @item.Count,
            ;
        }
        ];

        var totalStudents = @totalStudents;
        var coursePercentages = courseCounts.map(c => (c / totalStudents * 100).toFixed(2));

        var ctxCourse = document.getElementById('courseChart');
        new Chart(ctxCourse, {
            type: 'bar',
            data: {
                labels: courseLabels,
                datasets: [{
                    label: 'Percentage',
                    data: coursePercentages
                }]
            }
        });

        // Male vs Female
        var male = @maleCount;
        var female = @femaleCount;
        var total = male + female;
        var genderPercentages = [
            (male / total * 100).toFixed(2),
            (female / total * 100).toFixed(2)
        ];

        var ctxGender = document.getElementById('genderChart');
        new Chart(ctxGender, {
            type: 'pie',
            data: {
                labels: ['Male', 'Female'],
                datasets: [{
                    data: genderPercentages
                }]
            }
        });
    </script>
}
