@model IEnumerable<_231895urmenitaMVCCRUDOPERATION.Models._231895urmenitaCOURSE>

@{
    ViewData["Title"] = "Courses";
}

<h2>Courses</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Course</a>
</p>

<table class="table table-striped table-hover mt-3">
    <thead>
        <tr>
            <th>Description</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.DESCRIPTION</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@c.COURSEID">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@c.COURSEID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
